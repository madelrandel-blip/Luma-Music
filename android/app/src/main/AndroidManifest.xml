<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Luma Music v3: volvemos a lanzar la app completa de OpenTune
        (com.arturo254.opentune) en vez de la mini interfaz propia
        (com.lumamusic.android, v1/v2). Esa app completa ya vivia en el repo
        sin usarse (ver android/README-luma.md) - ahora es la que corre.
        El codigo de com.lumamusic.android queda sin referenciar aqui pero
        sigue compilando, igual que antes pasaba al reves con esta carpeta.
    -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Escaneo de musica local: en Android 13+ se pide READ_MEDIA_AUDIO; en versiones
         viejas, READ_EXTERNAL_STORAGE (con maxSdkVersion para no pedirla de mas). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Deteccion de auto-inicio por Bluetooth (BluetoothDevice.getName() en Android 12+). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name="com.arturo254.opentune.App"
        android:allowBackup="true"
        android:appCategory="audio"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenTune"
        tools:targetApi="tiramisu">

        <!-- Android Auto: la app expone su biblioteca via MusicService (MediaLibraryService). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name="com.arturo254.opentune.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.OpenTune"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Deep link interno lumamusic://together?... (invitacion al modo Together) y
                 lumamusic://login?... (recuperacion de sesion). Se generan en
                 TogetherLink.kt / MusicService.kt y se leen en handleDeepLinkIntent(). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lumamusic" />
            </intent-filter>
        </activity>

        <!-- Pantalla de crash: App.kt la lanza en el proceso separado ":crash" cuando
             hay una excepcion no capturada, para poder mostrar el stack trace incluso
             si el proceso principal murio. -->
        <activity
            android:name="com.arturo254.opentune.DebugActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.OpenTune" />

        <service
            android:name="com.arturo254.opentune.playback.MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <service
            android:name="com.arturo254.opentune.playback.ExoDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Widget de home screen (Glance) - un solo receiver/provider que dibuja el
             layout compacto/grande/vinilo/reproductor segun el tamano disponible. -->
        <receiver
            android:name="com.arturo254.opentune.widget.OpenTunePlayerWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/opentune_widget" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.FileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

    </application>

</manifest>
